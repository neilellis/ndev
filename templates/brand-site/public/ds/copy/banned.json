 "constructions": [
  {
   "id": "negation",
   "name": "“Not X, but Y” and “It isn’t X. It’s Y.”",
   "source": "banned-guide",
   "pattern": "\\bnot only\\b[^.]*\\bbut\\b|\\bit[’']?s not (?:about|just)\\b|\\bisn[’']t just\\b",
   "example": "“It isn’t just a platform. It’s a partnership.”",
   "fix": "State what it is. “{{product}} maps your teams, systems and AI agents together.”",
   "note": "The film’s opening headline uses this pattern: “The risk isn’t capability. It’s coordination.” It stays as source copy. Do not add new uses."
  },
  {
   "id": "triple",
   "name": "Three fragments for effect",
   "source": "banned-guide",
   "example": "“Clarity. Control. Confidence.”",
   "fix": "Say one specific thing. The house “Data · AI · Transformation” line names three real service areas, so it stays."
  },
  {
   "id": "false-range",
   "name": "False range: “from X to Y”",
   "source": "banned-guide",
   "example": "“From strategy to soul, from data to destiny.”",
   "fix": "Use “from … to” only for two ends of one real scale: “from discovery to delivery”."
  },
  {
   "id": "editorial-participle",
   "name": "A trailing “-ing” clause that explains the meaning",
   "source": "banned-guide",
   "pattern": ",\\s+(?:highlighting|underscoring|showcasing|emphasising|emphasizing|reflecting|symbolising|symbolizing|demonstrating|illustrating)\\b",
   "example": "“The council moved its data to one platform, highlighting its commitment to change.”",
   "fix": "Give the fact and its result. “The council moved its data to one platform. Reports that took a week now take a day.”"
  },
  {
   "id": "aphorism",
   "name": "Poster lines",
   "source": "banned-guide",
   "example": "“In the end, transformation is about people.”",
   "fix": "Cut it, or replace it with a claim the reader can test."
  },
  {
   "id": "epic",
   "name": "Epic tone for ordinary events",
   "source": "banned-guide",
   "example": "“A moment that changed everything for the organisation.”",
   "fix": "Scale the words to the event, and say what changed."
  },
  {
   "id": "echo",
   "name": "Echo lines that repeat the same point",
   "source": "banned-guide",
   "example": "“We listen. We really listen.”",
   "fix": "Keep the second sentence only if it adds a fact."
  },
  {
   "id": "variation",
   "name": "Different names for the same thing",
   "source": "simple-english",
   "example": "Calling one product “{{product}}”, “the platform”, “our tool” and “the map” on one page.",
   "fix": "One item, one name. Repeat the name."
  },
  {
   "id": "scenery",
   "name": "Opening on scenery",
   "source": "banned-guide",
   "example": "“In today’s fast-moving digital landscape…”",
   "fix": "Start with the reader’s problem or the point."
  },
  {
   "id": "vague-something",
   "name": "Vague “something” and “the weight of”",
   "source": "banned-guide",
   "example": "“Something shifts when teams see their data.”",
   "fix": "Name what changes and for whom."
  }
 ],
 "registers": {
  "internal": "Notes, emails, reports and proposals inside {{name}}.",
  "marketing": "The website, headlines, the film, articles and case studies.",
  "documentation": "Guides, this brand guide, client documents, forms and error messages.",
  "agent": "Agent files such as CLAUDE.md and AGENTS.md, skills and prompts.",
  "technical-documentation": "READMEs, developer guides, runbooks, API and code documentation. Common technical terms are allowed."
 }
}