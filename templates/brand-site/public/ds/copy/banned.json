{
 "version": 1,
 "description": "Words, phrases and constructions to keep out of {{name}} copy. Level 'ban' is for words with no place in plain English and fails the copy check. Level 'flag' is for ordinary words that are often misused: a person decides. Entries with 'registers' apply only to those registers. Entries with 'allow' do not apply in those registers.",
 "sources": {
  "banned-guide": "Common plain-English style guidance (informed by BANNED: The Definitive Guide), written in original wording for business documentation.",
  "simple-english": "The simple-english skill from https://github.com/AminBlg/SimpleEnglish (MIT licence), a paraphrase of ASD-STE100 Simplified Technical English.",
  "house": "{{name}} house rules and reviews."
 },
 "groups": [
  {
   "id": "corporate",
   "label": "Corporate and tech speak",
   "why": "These words sound important and carry no fact. Say what the thing does, or give the number."
  },
  {
   "id": "ai-vocabulary",
   "label": "AI vocabulary",
   "why": "Language models overuse these words. One alone is not wrong. A cluster makes text read as generated."
  },
  {
   "id": "puffery",
   "label": "Importance and legacy puffery",
   "why": "These phrases say that something matters without showing why. Show the consequence instead."
  },
  {
   "id": "promotional",
   "label": "Brochure and hype words",
   "why": "Advertising words tell the reader to be impressed. {{name}} is confident, not loud."
  },
  {
   "id": "framing",
   "label": "Pseudo-intellectual framing",
   "why": "These frames perform analysis. Name the actual thing."
  },
  {
   "id": "filler",
   "label": "Filler and wordy phrases",
   "why": "These phrases add words and no meaning. Use the short form, or delete the phrase."
  },
  {
   "id": "strict",
   "label": "Documentation, technical documentation and agent text only",
   "why": "These registers must be clear to a reader who cannot ask a question. These words can make a rule optional or vague. Internal and marketing text can use them."
  }
 ],
